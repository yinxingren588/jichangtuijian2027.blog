---
export interface Props {
  title: string;
  description: string;
  ctaLabel: string;
  ctaHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  maxWidth?: string;
}

const {
  title,
  description,
  ctaLabel,
  ctaHref,
  secondaryLabel,
  secondaryHref,
  maxWidth = '1040px',
} = Astro.props;
---

<div class="page-cta-banner glass-card" style={`max-width: ${maxWidth};`}>
  <div class="cta-text">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
  <div class="cta-actions">
    <a href={ctaHref} class="btn btn-accent">
      {ctaLabel}
    </a>
    {secondaryLabel && secondaryHref && (
      <a href={secondaryHref} class="btn btn-outline">
        {secondaryLabel}
      </a>
    )}
  </div>
</div>

<style>
  .page-cta-banner {
    margin: 2.75rem auto 0;
    padding: 1.85rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.15rem;
    border: 1px solid rgba(234, 88, 12, 0.25);
    background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  }

  @media (min-width: 768px) {
    .page-cta-banner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .cta-text h3 {
    font-size: 1.15rem;
    color: #9a3412;
    margin-bottom: 0.25rem;
  }

  .cta-text p {
    font-size: 0.88rem;
    color: #7c2d12;
    line-height: 1.55;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }
</style>
