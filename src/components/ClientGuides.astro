---
const clients = [
  {
    os: 'Windows 客户端',
    icon: '🪟',
    recommend: 'Clash Verge Rev / Sing-box',
    desc: '推荐使用开源的 Clash Verge Rev，界面简洁美观，支持内核自动更新与延迟智能选路。',
    steps: ['下载安装客户端', '机场后台复制 Clash 订阅', '在客户端订阅管理中粘贴并保存', '选择节点并开启系统代理'],
  },
  {
    os: 'macOS 苹果电脑',
    icon: '🍎',
    recommend: 'Clash Verge Rev / Surge / Loon',
    desc: '原生适配 Apple M系列与 Intel 芯片。轻量低耗电，完美分流 Apple 官方服务与国内直连流量。',
    steps: ['安装对应 DMG 安装包', '一键导入机场订阅链接', '开启增强模式（Tun虚拟网卡）', '享受无缝极速上网'],
  },
  {
    os: 'iOS 苹果手机/iPad',
    icon: '📱',
    recommend: 'Shadowrocket（小火箭）/ Loon',
    desc: '需使用美区/港区外区 Apple ID 在 App Store 下载。支持一键扫码配置，省电稳定。',
    steps: ['登录外区 App Store 下载小火箭', '在机场用户中心点击一键导入小火箭', '允许添加 VPN 权限配置', '开关打开即可使用'],
  },
  {
    os: 'Android 安卓手机/车机',
    icon: '🤖',
    recommend: 'Clash Meta for Android / Sing-box',
    desc: '完美兼容各大国产安卓厂商系统（小米澎湃/华为鸿蒙/OPPO/vivo）。支持按应用分流。',
    steps: ['下载 APK 并完成本地安装', '复制订阅 URL 到配置界面', '下载配置文件并切换至指定规则', '点击启动开关'],
  },
];
---

<div class="client-grid">
  {clients.map((c) => (
    <div class="client-card glass-card">
      <div class="client-top">
        <span class="os-icon">{c.icon}</span>
        <div class="os-info">
          <h4 class="os-name">{c.os}</h4>
          <span class="os-recommend">{c.recommend}</span>
        </div>
      </div>
      <p class="client-desc">{c.desc}</p>
      <div class="steps-box">
        <div class="steps-title">四步快速上手流程：</div>
        <ol class="steps-list">
          {c.steps.map((s, index) => (
            <li>
              <span class="step-num">{index + 1}</span>
              <span class="step-text">{s}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  ))}
</div>

<style>
  .client-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .client-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .client-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .client-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-radius: 0.75rem;
    background: #ffffff;
    border: 1px solid var(--border-color);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
  }

  .client-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .os-icon {
    font-size: 2rem;
  }

  .os-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f172a;
  }

  .os-recommend {
    font-size: 0.75rem;
    color: var(--accent-blue);
    font-weight: 600;
  }

  .client-desc {
    font-size: 0.85rem;
    color: #475569;
    line-height: 1.5;
  }

  .steps-box {
    background: #f8fafc;
    padding: 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid #e2e8f0;
    margin-top: auto;
  }

  .steps-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: #64748b;
    margin-bottom: 0.5rem;
  }

  .steps-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .steps-list li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: #334155;
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: #e0f2fe;
    color: #0284c7;
    font-size: 0.65rem;
    font-weight: 800;
    flex-shrink: 0;
  }
</style>
