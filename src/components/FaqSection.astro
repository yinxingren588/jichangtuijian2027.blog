---
import {
  FAQS,
  FAQ_CATEGORIES,
  getFaqCategoryLabel,
  formatFaqAnswerHtml,
  faqToPlainText,
} from '../data/faqs';

export interface Props {
  mode?: 'home' | 'full';
}

const { mode = 'home' } = Astro.props;
const INITIAL_HOME_LIMIT = 16;

// 统计每个分类条数
const categoryCounts = FAQS.reduce<Record<string, number>>((acc, item) => {
  acc[item.category] = (acc[item.category] || 0) + 1;
  return acc;
}, {});
---

<div class="faq-root" data-faq-root data-mode={mode} data-home-limit={INITIAL_HOME_LIMIT}>
  <!-- 顶部检索与控制栏 -->
  <div class="faq-toolbar glass-card">
    <div class="faq-search-row">
      <div class="faq-search-wrap">
        <span class="search-icon" aria-hidden="true">🔍</span>
        <input
          type="search"
          class="faq-search-input"
          data-faq-search
          placeholder={`搜索 ${FAQS.length} 条问答：如 IPLC、ChatGPT、电信、小火箭、按月付费、隐形人...`}
          aria-label="搜索常见问题"
        />
      </div>

      <div class="faq-actions">
        <button type="button" class="action-btn" data-faq-expand-all>全部展开</button>
        <button type="button" class="action-btn" data-faq-collapse-all>全部收起</button>
      </div>
    </div>

    <!-- 分类筛选胶囊 -->
    <div class="faq-categories" role="tablist" aria-label="FAQ 分类筛选">
      <button
        type="button"
        class="cat-pill is-active"
        data-faq-cat="all"
        role="tab"
        aria-selected="true"
      >
        <span>📚 全部问题</span>
        <span class="cat-count">{FAQS.length}</span>
      </button>

      {FAQ_CATEGORIES.map((cat) => (
        <button
          type="button"
          class="cat-pill"
          data-faq-cat={cat.id}
          role="tab"
          aria-selected="false"
          title={cat.description}
        >
          <span>{cat.icon} {cat.label}</span>
          <span class="cat-count">{categoryCounts[cat.id] || 0}</span>
        </button>
      ))}
    </div>

    <div class="faq-status-bar">
      <span class="status-text" data-faq-status>
        {mode === 'home'
          ? `精选展示前 ${Math.min(INITIAL_HOME_LIMIT, FAQS.length)} 条，共收录 ${FAQS.length} 条专业问答`
          : `共收录 ${FAQS.length} 条 2027 科学上网与机场推荐问答`}
      </span>
      {mode === 'home' && (
        <a href="/faq" class="full-faq-link">
          打开独立 60+ FAQ 百科全书页面 →
        </a>
      )}
    </div>
  </div>

  <!-- 问答折叠列表 -->
  <div class="faqs-list" data-faq-list>
    {FAQS.map((faq, index) => {
      const searchCorpus = `${faq.question} ${faqToPlainText(faq.answer)} ${(faq.keywords || []).join(' ')} ${getFaqCategoryLabel(faq.category)}`.toLowerCase();
      const hiddenInitially = mode === 'home' && index >= INITIAL_HOME_LIMIT;
      return (
        <details
          id={faq.id}
          class={`faq-item glass-card${hiddenInitially ? ' is-hidden' : ''}`}
          data-faq-item
          data-category={faq.category}
          data-search={searchCorpus}
          open={index === 0}
        >
          <summary class="faq-question">
            <span class="q-icon">Q{index + 1}</span>
            <div class="q-main">
              <span class="q-cat-tag">{getFaqCategoryLabel(faq.category)}</span>
              <span class="q-text">{faq.question}</span>
            </div>
            <span class="toggle-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>
          <div class="faq-answer" set:html={formatFaqAnswerHtml(faq.answer)} />
        </details>
      );
    })}
  </div>

  <!-- 无匹配结果空状态 -->
  <div class="faq-empty is-hidden" data-faq-empty>
    <p>😕 未找到包含该关键词的 FAQ 问答，请尝试缩短搜索词或切换回「全部问题」。</p>
    <button type="button" class="btn btn-outline btn-sm" data-faq-reset>重置筛选条件</button>
  </div>

  <!-- 首页模式底部展开全部控制栏 -->
  {mode === 'home' && FAQS.length > INITIAL_HOME_LIMIT && (
    <div class="faq-footer-controls" data-faq-footer>
      <button type="button" class="btn btn-primary" data-faq-toggle-more>
        展开查看全部 {FAQS.length} 条 FAQ 问答（还剩 {FAQS.length - INITIAL_HOME_LIMIT} 条）↓
      </button>
      <a href="/faq" class="btn btn-outline">
        📖 前往完整 FAQ 百科专页 →
      </a>
    </div>
  )}
</div>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-faq-root]').forEach((root) => {
      if (root.getAttribute('data-faq-bound') === 'true') return;
      root.setAttribute('data-faq-bound', 'true');

      const mode = root.getAttribute('data-mode') || 'home';
      const homeLimit = parseInt(root.getAttribute('data-home-limit') || '16', 10);

      const searchInput = root.querySelector('[data-faq-search]');
      const catButtons = Array.from(root.querySelectorAll('[data-faq-cat]'));
      const items = Array.from(root.querySelectorAll('[data-faq-item]'));
      const statusEl = root.querySelector('[data-faq-status]');
      const emptyEl = root.querySelector('[data-faq-empty]');
      const footerEl = root.querySelector('[data-faq-footer]');
      const toggleMoreBtn = root.querySelector('[data-faq-toggle-more]');
      const expandAllBtn = root.querySelector('[data-faq-expand-all]');
      const collapseAllBtn = root.querySelector('[data-faq-collapse-all]');
      const resetBtn = root.querySelector('[data-faq-reset]');

      let activeCategory = 'all';
      let query = '';
      let showAllInHome = false;

      const applyFilters = () => {
        const isFiltered = activeCategory !== 'all' || query.length > 0;
        let matchedCount = 0;
        let visibleCount = 0;

        items.forEach((item) => {
          const itemCat = item.getAttribute('data-category') || '';
          const itemText = item.getAttribute('data-search') || '';
          const catMatch = activeCategory === 'all' || itemCat === activeCategory;
          const queryMatch = !query || itemText.includes(query);

          if (catMatch && queryMatch) {
            matchedCount += 1;
            const shouldLimit = mode === 'home' && !isFiltered && !showAllInHome && matchedCount > homeLimit;
            if (shouldLimit) {
              item.classList.add('is-hidden');
            } else {
              item.classList.remove('is-hidden');
              visibleCount += 1;
            }
          } else {
            item.classList.add('is-hidden');
          }
        });

        if (emptyEl) {
          emptyEl.classList.toggle('is-hidden', matchedCount > 0);
        }

        if (statusEl) {
          if (isFiltered) {
            statusEl.textContent = `当前筛选命中 ${matchedCount} 条相关问答（共 ${items.length} 条）`;
          } else if (mode === 'home' && !showAllInHome) {
            statusEl.textContent = `精选展示前 ${visibleCount} 条，点击下方按钮或分类可浏览全部 ${items.length} 条问答`;
          } else {
            statusEl.textContent = `正在显示全部 ${visibleCount} 条 2027 科学上网与机场推荐问答`;
          }
        }

        if (footerEl && toggleMoreBtn) {
          footerEl.classList.toggle('is-hidden', isFiltered);
          if (!isFiltered) {
            const remaining = items.length - homeLimit;
            toggleMoreBtn.textContent = showAllInHome
              ? `收起部分问答（仅展示精选前 ${homeLimit} 条）↑`
              : `展开查看全部 ${items.length} 条 FAQ 问答（还剩 ${remaining} 条）↓`;
          }
        }
      };

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          query = (e.target.value || '').trim().toLowerCase();
          applyFilters();
        });
      }

      catButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          activeCategory = btn.getAttribute('data-faq-cat') || 'all';
          catButtons.forEach((b) => {
            const isActive = b === btn;
            b.classList.toggle('is-active', isActive);
            b.setAttribute('aria-selected', isActive ? 'true' : 'false');
          });
          applyFilters();
        });
      });

      if (toggleMoreBtn) {
        toggleMoreBtn.addEventListener('click', () => {
          showAllInHome = !showAllInHome;
          applyFilters();
        });
      }

      if (expandAllBtn) {
        expandAllBtn.addEventListener('click', () => {
          if (mode === 'home' && activeCategory === 'all' && !query && !showAllInHome) {
            showAllInHome = true;
            applyFilters();
          }
          items.forEach((item) => {
            if (!item.classList.contains('is-hidden')) {
              item.setAttribute('open', '');
            }
          });
        });
      }

      if (collapseAllBtn) {
        collapseAllBtn.addEventListener('click', () => {
          items.forEach((item) => item.removeAttribute('open'));
        });
      }

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          activeCategory = 'all';
          query = '';
          if (searchInput) searchInput.value = '';
          catButtons.forEach((b) => {
            const isAll = b.getAttribute('data-faq-cat') === 'all';
            b.classList.toggle('is-active', isAll);
            b.setAttribute('aria-selected', isAll ? 'true' : 'false');
          });
          applyFilters();
        });
      }
    });
  })();
</script>

<style>
  .faq-root {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .faq-toolbar {
    padding: 1.25rem;
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
  }

  .faq-search-row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .faq-search-row {
      flex-direction: row;
      align-items: center;
    }
  }

  .faq-search-wrap {
    position: relative;
    flex: 1;
  }

  .search-icon {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.95rem;
    pointer-events: none;
  }

  .faq-search-input {
    width: 100%;
    padding: 0.7rem 1rem 0.7rem 2.45rem;
    border-radius: 0.6rem;
    border: 1px solid #cbd5e1;
    background: #f8fafc;
    color: #0f172a;
    font-size: 0.9rem;
    transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
  }

  .faq-search-input:focus {
    outline: none;
    background: #ffffff;
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
  }

  .faq-actions {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .action-btn {
    padding: 0.65rem 0.95rem;
    border-radius: 0.55rem;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #334155;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .action-btn:hover {
    background: #f1f5f9;
    border-color: #94a3b8;
    color: #0f172a;
  }

  .faq-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cat-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.8rem;
    border-radius: 9999px;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    color: #475569;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .cat-pill:hover {
    border-color: #93c5fd;
    color: #0284c7;
    background: #f0f9ff;
  }

  .cat-pill.is-active {
    background: #2563eb;
    border-color: #2563eb;
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.25);
  }

  .cat-count {
    font-size: 0.72rem;
    padding: 0.08rem 0.42rem;
    border-radius: 9999px;
    background: rgba(15, 23, 42, 0.08);
    color: inherit;
  }

  .cat-pill.is-active .cat-count {
    background: rgba(255, 255, 255, 0.22);
    color: #ffffff;
  }

  .faq-status-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid #f1f5f9;
    font-size: 0.82rem;
    color: #64748b;
  }

  .full-faq-link {
    color: #2563eb;
    font-weight: 600;
  }

  .full-faq-link:hover {
    text-decoration: underline;
  }

  .faqs-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .faq-item {
    border-radius: 0.75rem;
    transition: all 0.2s ease;
    background: #ffffff;
    border: 1px solid var(--border-color);
  }

  .faq-item.is-hidden,
  .faq-empty.is-hidden,
  .faq-footer-controls.is-hidden {
    display: none;
  }

  .faq-item[open] {
    border-color: #38bdf8;
    background: #f8fafc;
    box-shadow: 0 6px 18px rgba(2, 132, 199, 0.07);
  }

  .faq-question {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.05rem 1.25rem;
    font-size: 1rem;
    font-weight: 700;
    color: #0f172a;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .q-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    height: 1.65rem;
    padding: 0 0.4rem;
    border-radius: 0.4rem;
    background: rgba(2, 132, 199, 0.1);
    color: #0284c7;
    font-size: 0.78rem;
    font-weight: 800;
    flex-shrink: 0;
    font-family: monospace;
  }

  .q-main {
    flex-grow: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .q-cat-tag {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.12rem 0.5rem;
    border-radius: 9999px;
    background: #f1f5f9;
    color: #475569;
    border: 1px solid #e2e8f0;
    flex-shrink: 0;
  }

  .q-text {
    line-height: 1.45;
  }

  .toggle-icon {
    color: #94a3b8;
    transition: transform 0.2s;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .faq-item[open] .toggle-icon {
    transform: rotate(180deg);
    color: #0284c7;
  }

  .faq-answer {
    padding: 0 1.25rem 1.25rem 4.35rem;
    color: #334155;
    font-size: 0.94rem;
    line-height: 1.75;
  }

  @media (max-width: 640px) {
    .faq-answer {
      padding: 0 1rem 1.15rem 1rem;
    }
  }

  .faq-answer :global(p) {
    margin-bottom: 0.65rem;
  }

  .faq-answer :global(p:last-child),
  .faq-answer :global(ul:last-child),
  .faq-answer :global(ol:last-child) {
    margin-bottom: 0;
  }

  .faq-answer :global(ul),
  .faq-answer :global(ol) {
    margin: 0.5rem 0 0.75rem;
    padding-left: 1.35rem;
  }

  .faq-answer :global(li) {
    margin-bottom: 0.35rem;
  }

  .faq-answer :global(strong) {
    color: #0f172a;
    font-weight: 700;
  }

  .faq-answer :global(code) {
    background: #e2e8f0;
    color: #0369a1;
    padding: 0.1rem 0.38rem;
    border-radius: 0.28rem;
    font-family: monospace;
    font-size: 0.86em;
  }

  .faq-empty {
    text-align: center;
    padding: 2.5rem 1.25rem;
    background: #ffffff;
    border: 1px dashed #cbd5e1;
    border-radius: 0.75rem;
    color: #475569;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .faq-footer-controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }
</style>
