---
import { SITE_CONFIG } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  schemaJson?: Record<string, any> | Record<string, any>[];
}

const {
  title = SITE_CONFIG.title,
  description = SITE_CONFIG.description,
  keywords = SITE_CONFIG.keywords,
  canonicalUrl = Astro.url.href,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  schemaJson,
} = Astro.props;

// 确保规范 URL 使用正式域名 https://jichangtuijian2027.blog
const resolvedCanonical = new URL(Astro.url.pathname, SITE_CONFIG.url).href;

// 默认基础结构化数据 (WebSite & Organization)
const defaultWebsiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': SITE_CONFIG.name,
  'url': SITE_CONFIG.url,
  'description': SITE_CONFIG.description,
  'potentialAction': {
    '@type': 'SearchAction',
    'target': `${SITE_CONFIG.url}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const defaultOrgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': SITE_CONFIG.name,
  'url': SITE_CONFIG.url,
  'logo': `${SITE_CONFIG.url}/favicon.svg`,
};

const schemasToRender = schemaJson
  ? Array.isArray(schemaJson)
    ? [defaultWebsiteSchema, defaultOrgSchema, ...schemaJson]
    : [defaultWebsiteSchema, defaultOrgSchema, schemaJson]
  : [defaultWebsiteSchema, defaultOrgSchema];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- 核心 Bing SEO 标题与元数据 -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={SITE_CONFIG.author} />
    <link rel="canonical" href={resolvedCanonical} />

    <!-- 搜索引擎爬虫指示 (Bingbot / Googlebot) -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large" />

    <!-- IndexNow 验证与快捷引用 -->
    <link rel="indexnow" href="/e9a8f273b1454c5e89d14f2a781290bc.txt" />

    <!-- Open Graph / 社交分享卡片 -->
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE_CONFIG.url}/og-cover.png`} />
    <meta property="og:locale" content={SITE_CONFIG.locale} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_CONFIG.url}/og-cover.png`} />

    <!-- 结构化数据 Schema.org JSON-LD (极大提高 Bing 搜索富媒体结果展现率) -->
    {schemasToRender.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <a href="#main-content" class="sr-only">跳转到主要内容</a>
    
    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <!-- 全局轻量交互脚本：优惠码复制提示与锚点平滑导航 -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // 绑定一键复制优惠码
        document.querySelectorAll('[data-copy-code]').forEach((button) => {
          button.addEventListener('click', async (e) => {
            const code = button.getAttribute('data-copy-code');
            if (!code) return;
            try {
              await navigator.clipboard.writeText(code);
              const originalText = button.innerHTML;
              button.innerHTML = '✅ 已复制优惠码';
              button.style.filter = 'brightness(1.2)';
              setTimeout(() => {
                button.innerHTML = originalText;
                button.style.filter = 'none';
              }, 2000);
            } catch (err) {
              prompt('请手动复制优惠码：', code);
            }
          });
        });
      });
    </script>
  </body>
</html>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
