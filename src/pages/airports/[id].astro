  }

  @media (min-width: 768px) {
    .bh-specs-row {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .bhs-item {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 0.65rem;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .bhs-k {
    font-size: 0.75rem;
    color: #64748b;
  }

  .bhs-v {
    font-size: 0.9rem;
    font-weight: 700;
    color: #0f172a;
  }

  .bhs-v.gold { color: #d97706; }
  .bhs-v.blue { color: #0284c7; }
  .bhs-v.green { color: #059669; }

  .bh-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #e2e8f0;
  }

  .bh-coupon {
