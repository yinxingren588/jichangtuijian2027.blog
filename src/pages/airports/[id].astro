    .bh-top {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }
  }

  .bh-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .bh-left h1 {
    font-size: 1.75rem;
    font-weight: 900;
    color: #0f172a;
    line-height: 1.3;
    margin-bottom: 0.65rem;
  }

  .bh-summary {
    font-size: 0.94rem;
    color: #475569;
    line-height: 1.65;
    max-width: 680px;
  }

  .bh-price-box {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 0.9rem;
    padding: 1.1rem 1.35rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex-shrink: 0;
    min-width: 210px;
  }

  .bp-label {
    font-size: 0.75rem;
    color: #1d4ed8;
    font-weight: 700;
  }

